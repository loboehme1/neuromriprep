// TODO nf-core: Once you have added the required tests, please run the following command to build this file:
// nf-core modules test pydeface

nextflow_process {

    name "Test Process PYDEFACE"
    script "../main.nf"
    process "PYDEFACE"

    tag "modules"
    tag "modules_local"
    tag "pydeface"

    test("single T1w nifti creates defaces image and logs") {


        when {
            process {
                """
                input[0] = [
                    [ subject:'01', session: '006'],
                    file(params.pydeface_test_data, checkIfExists: true),
                    file(params.pydeface_test_data + '/ds000031_sub-01_ses-006_run-001_T1w.nii.gz', checkIfExists: true)
                ]
                """
            }
        }

        then {

            // check if test case succeeded
            assert process.success
            assert process.trace.tasks().size() == 1

            // exactly one file per input nifti for normal output and publish output
            assert process.out.defaced.size() == 1
            assert process.out.defaced_publish.size() >= 1

            // logs should exist
            assert process.out.logs.size() >= 1

            // helper functions
            def asList = { x ->
                x instanceof Collection ? x as List : [x]
            }

            def flatten = { xs ->
                xs.collectMany { it instanceof Collection ? it as List : [it] }
            }

            def basename = { x ->
                new File(x.toString()).name
            }

            def exists = { x ->
                new File(x.toString()).exists()
            }

            def fileSize = { x ->
                new File(x.toString()).length()
            }

            // get all module outputs
            def meta = process.out.defaced[0][0]
            def defacedFiles = asList(process.out.defaced[0][1])
            def publishFiles = flatten(process.out.defaced_publish)
            def logFiles = flatten(process.out.logs)

            // check meta data
            assert meta.subject == '01'
            assert meta.session == '006'

            // defaced output check
            assert defacedFiles.size() == 1
            assert basename(defacedFiles[0]) == 'ds000031_sub-01_ses-006_run-001_T1w_defaced.nii.gz'
            assert exists(defacedFiles[0])
            assert fileSize(defacedFiles[0]) > 0

            // publish output check
            assert publishFiles.collect { basename(it) }.contains('ds000031_sub-01_ses-006_run-001_T1w_defaced.nii.gz')

            // logs check
            assert logFiles.collect { basename(it) }.sort() == [
                'sub-01_ses-006_ds000031_sub-01_ses-006_run-001_T1w_err.log',
                'sub-01_ses-006_ds000031_sub-01_ses-006_run-001_T1w_out.log'
            ]

            assert logFiles.every { exists(it) }

            assert snapshot(
                [
                    meta: [
                        subject: meta.subject,
                        session: meta.session
                    ],
                    defaced: defacedFiles.collect { basename(it) }.sort(),
                    defaced_publish: publishFiles.collect { basename(it) }.sort(),
                    logs: logFiles.collect { basename(it) }.sort()
                ]
            ).match("pydeface_outputs")
        }
    }
}
