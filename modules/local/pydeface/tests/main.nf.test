// TODO nf-core: Once you have added the required tests, please run the following command to build this file:
// nf-core modules test pydeface

nextflow_process {

    name "Test Process PYDEFACE"
    script "../../../../modules/local/pydeface.nf"
    process "PYDEFACE"

    tag "modules"
    tag "modules_local"
    tag "pydeface"

    test("single T1w nifti creates defaces image and logs") {

        def jsonFile  = /home/loboehme/Documents/test_data/pydeface/ds000031_sub-01_ses-006_run-001_T1w.json
        def niftiFile = /home/loboehme/Documents/test_data/pydeface/ds000031_sub-01_ses-006_run-001_T1w.nii.gz

        when {
            process {
                """
                input[0] = [
                    [ subject:'01', session: '006'],
                    file('/home/loboehme/Documents/test_data/pydeface/ds000031_sub-01_ses-006_run-001_T1w.json'),
                    file('/home/loboehme/Documents/test_data/pydeface/ds000031_sub-01_ses-006_run-001_T1w.nii.gz')
                ]
                """
            }
        }

        then {
            // check if test case succeeded
            assert process.success

            // exactly one file per input nifti for normal output and publish output
            assert process.out.defaced.size() == 1
            assert process.out.defaced_publish.size() >= 1

            // exactly one log file per run
            assert process.out.logs.size() >= 1


            // helper functions
            def asList = { x ->
                x instanceof Collection ? x as List : [x]
            }

            def flatten = { xs ->
                xs.collectMany { it instanceof Collection ? it as List : [it] }
            }

            // get all module outputs: meta from defaced, defaced from defaced, defaced from publish, logs from logs
            def meta = process.out.defaced[0][0]
            def defacedFiles = asList(process.out.defaced[0][1])
            def publishFiles = flatten(process.out.defaced_publish)
            def logFiles = flatten(process.out.logs)


            // check meta data --> we know the session and subject as specified by input
            assert meta.subject == '01'
            assert meta.session == '006'

            // defaced output check: number of files, name, exists
            assert defacedFiles.size() == 1
            assert defacedFiles[0].name == 'ds000031_sub-01_ses-006_run-001_T1w_defaced.nii.gz'
            assert new File(defacedFiles[0].toString()).exists()
            assert new File(defacedFiles[0].toString()).length() > 0

            // publish output check: name
            assert publishFiles*.name.contains('ds000031_sub-01_ses-006_run-001_T1w_defaced.nii.gz')

            // logs check: error lo, normal log, names, exists
            assert logFiles*.name.sort() == [
                'sub-01_ses-006_ds000031_sub-01_ses-006_run-001_T1w_err.log',
                'sub-01_ses-006_ds000031_sub-01_ses-006_run-001_T1w_out.log'
            ]

            assert logFiles.every { new File(it.toString()).exists() }
        }

    }

}
